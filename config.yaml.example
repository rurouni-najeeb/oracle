tasks:
  vault_path: ~/Documents/Obsidian Vault
  inbox_file: daily

pomodoro:
  work_minutes: 25
  short_break_minutes: 5
  long_break_minutes: 15
  sessions_before_long_break: 4

rss:
  feeds:
    - name: Hacker News
      url: https://hnrss.org/frontpage
  refresh_interval_minutes: 5

github:
  orgs:
    - my-org
